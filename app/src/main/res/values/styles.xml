<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LumaStay" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/navy</item>
        <item name="colorPrimaryVariant">@color/navy_light</item>
        <item name="colorSecondary">@color/gold</item>
        <item name="colorError">@color/error</item>
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:navigationBarColor">@color/canvas</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="materialButtonStyle">@style/LumaButton</item>
    </style>
    <style name="Theme.LumaStay.Splash" parent="Theme.LumaStay">
        <item name="android:windowBackground">@color/navy</item>
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:navigationBarColor">@color/navy</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="LumaButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="LumaField" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxBackgroundColor">@color/white</item>
        <item name="hintTextColor">@color/navy_light</item>
        <item name="boxStrokeColor">@color/navy_light</item>
    </style>
</resources>
