<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/canvas">
  <ScrollView android:id="@+id/form_scroll" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/canvas">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="200dp"
            android:background="@drawable/bg_hero" android:paddingStart="24dp" android:paddingEnd="24dp"
            android:paddingTop="52dp" android:paddingBottom="32dp" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_luma_mark" android:contentDescription="@string/app_name" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
                    android:text="ЛЮМА" android:textColor="@color/white" android:textSize="20sp" android:fontFamily="sans-serif-medium" android:letterSpacing="0.12" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
                android:text="Ваш отдых начинается здесь" android:textColor="@color/white" android:textSize="27sp" android:fontFamily="sans-serif-medium" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="Заполните заявку на проживание. Данные сохраняются на этом устройстве."
                android:textColor="@color/gold_light" android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="01  Даты проживания"
                android:textColor="@color/navy" android:textSize="18sp" android:fontFamily="sans-serif-medium" android:layout_marginTop="8dp" android:layout_marginBottom="14dp" />
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/check_in_layout" style="@style/LumaField"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Дата заезда *" app:helperText="Нажмите, чтобы выбрать даты">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/check_in" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:focusable="false" android:clickable="true" android:inputType="none" android:drawableEnd="@drawable/ic_calendar" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/check_out_layout" style="@style/LumaField"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="Дата выезда *" app:helperText="Выезд позже даты заезда">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/check_out" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:focusable="false" android:clickable="true" android:inputType="none" android:drawableEnd="@drawable/ic_calendar" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:id="@+id/stay_summary" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="Выберите даты заезда и выезда" android:textColor="@color/muted" android:textSize="14sp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="02  Гость"
                android:textColor="@color/navy" android:textSize="18sp" android:fontFamily="sans-serif-medium" android:layout_marginTop="28dp" android:layout_marginBottom="14dp" />
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/name_layout" style="@style/LumaField"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Фамилия и имя *" app:helperText="Как в паспорте, минимум два слова">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textPersonName|textCapWords" android:maxLength="100" android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/passport_layout" style="@style/LumaField"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="Серия и номер паспорта *" app:helperText="10 цифр: 4 цифры серии и 6 номера">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/passport" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="number" android:maxLength="10" android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/phone_layout" style="@style/LumaField"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="Телефон *" app:helperText="Например, +7 999 123-45-67">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/phone" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="phone" android:maxLength="20" android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/email_layout" style="@style/LumaField"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="Электронная почта *" app:helperText="Для связи по заявке">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/email" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textEmailAddress" android:maxLength="150" android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="03  Номер"
                android:textColor="@color/navy" android:textSize="18sp" android:fontFamily="sans-serif-medium" android:layout_marginTop="28dp" android:layout_marginBottom="14dp" />
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/guests_layout" style="@style/LumaField"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Число гостей *" app:helperText="От 1 до 8 человек">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/guests" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="number" android:maxLength="2" android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/room_layout" style="@style/LumaField"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="Категория номера *" app:endIconMode="dropdown_menu">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/room" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:inputType="none" android:paddingStart="16dp" android:paddingEnd="12dp" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/wishes_layout" style="@style/LumaField"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="Пожелания" app:helperText="Необязательно, до 500 символов" app:counterEnabled="true" app:counterMaxLength="500">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/wishes" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textMultiLine|textCapSentences" android:minLines="3" android:maxLines="5" android:maxLength="500" android:gravity="top" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"
                android:padding="18dp" android:background="@drawable/bg_card" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Уведомления"
                    android:textColor="@color/ink" android:textSize="16sp" android:fontFamily="sans-serif-medium" />
                <TextView android:id="@+id/notification_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="Можно получить уведомление о подготовленной заявке. Это необязательно."
                    android:textColor="@color/muted" android:textSize="14sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/notifications_button"
                    style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="Включить уведомления" android:textAllCaps="false" android:letterSpacing="0" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton android:id="@+id/check_button"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:minHeight="52dp" android:text="Проверить поля" android:textAllCaps="false" android:letterSpacing="0" />
            <com.google.android.material.button.MaterialButton android:id="@+id/submit_button"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="Подготовить заявку" android:textAllCaps="false" android:letterSpacing="0" android:enabled="false" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:layout_marginBottom="22dp" android:gravity="center" android:text="Демо-форма: бронирование не отправляется в отель"
                android:textColor="@color/muted" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
  </ScrollView>
  <View android:id="@+id/status_scrim" android:layout_width="match_parent" android:layout_height="24dp"
      android:layout_gravity="top" android:background="@color/navy" />
</FrameLayout>
